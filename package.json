{
  "name": "@comput/pi-intercom",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbundgaard/PiIntercom.git"
  },
  "homepage": "https://github.com/mbundgaard/PiIntercom#readme",
  "bugs": {
    "url": "https://github.com/mbundgaard/PiIntercom/issues"
  },
  "version": "0.2.1",
  "description": "Explicit local communication between Pi sessions; Pi orchestrates.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "dashboard",
    "README.md",
    "references/observability.md",
    "references/v1-specification.md",
    "references/implementation-blocker.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "typebox": "1.3.7"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/core.test.mjs tests/integration.test.mjs tests/launcher.test.mjs tests/extension.test.mjs tests/runtime-http.test.mjs tests/resume-storage.test.mjs tests/observability.test.mjs tests/dashboard.test.mjs tests/dashboard-security.test.mjs tests/observability-integration.test.mjs",
    "test:host": "node --test tests/pi-cancellation-probe.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts"
  }
}
